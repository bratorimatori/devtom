# --- Inquiry form delivery -------------------------------------------------
# Pick ONE. Without either, the form returns a clear "not connected" error
# rather than silently swallowing enquiries.

# Option A — Resend (https://resend.com). Verify devtom.co, then:
# RESEND_API_KEY=re_xxxxxxxxxxxx
# INQUIRY_FROM="DevTom site <site@devtom.co>"

# Option B — Formspree (https://formspree.io). No domain setup needed.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Where enquiries land (defaults to hello@devtom.co)
# INQUIRY_TO=hello@devtom.co

# --- Calendly --------------------------------------------------------------
# Your scheduling link. Without it the "Schedule a call" button is hidden
# and the form is the only path.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min
